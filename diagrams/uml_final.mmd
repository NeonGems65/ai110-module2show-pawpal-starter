classDiagram
    %% PawPal+ final class design
    %% Reflects the final implementation in pawpal_system.py.

    class Owner {
        +str name
        +str contact_info
        +list~Pet~ pets
        +list~TimeSlot~ available_times
        +create_pet(name, species) Pet
        +list_pets() list~Pet~
        +filter_tasks(completed, pet_name) list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(description, duration, priority, due, recurrence) Task
        +list_tasks() list~Task~
        +manage_task(task) None
        +complete_task(task) Task
    }

    class Task {
        +str id
        +str description
        +int duration
        +int priority
        +datetime due_time
        +bool completed
        +str recurrence
        +mark_complete() None
        +is_recurring() bool
        +next_occurrence() Task
        +is_overdue(now) bool
    }

    class TimeSlot {
        +datetime start
        +datetime end
    }

    class ScheduledTask {
        +Task task
        +datetime start
        +datetime end
    }

    class Scheduler {
        +generate_plan(owner) list~ScheduledTask~
        +sort_by_priority(tasks) list~Task~
        +sort_by_time(tasks) list~Task~
        +filter_by_available_time(tasks, slots) list~Task~
        +resolve_conflicts(tasks, slots) list~ScheduledTask~
        +detect_conflicts(owner) list~str~
        +explain_plan(plan) str
    }

    Owner "1" o-- "*" Pet : owns
    Pet "1" o-- "*" Task : has
    Owner "1" o-- "*" TimeSlot : has availability
    ScheduledTask "*" --> "1" Task : wraps
    Scheduler ..> Owner : reads
    Scheduler ..> Pet : reads tasks from
    Scheduler ..> Task : schedules
    Scheduler ..> TimeSlot : fits tasks into
    Scheduler ..> ScheduledTask : produces
